MANAGER_HOST=0.0.0.0
MANAGER_PORT=9100
MANAGER_SESSION_SECRET=change-me-manager-session
MANAGER_S2S_KEY=change-me-s2s-key

# 生产示例：mysql+pymysql://user:pass@127.0.0.1:33306/hipp_manager（口令中 @ 写 %40）
# 空则开发用工程根 data/manager.db（SQLite）
DATABASE_URL=

# SMS_MOCK=1 时可不配 Redis / 阿里云
SMS_MOCK=1
REDIS_URL=redis://127.0.0.1:6379/3
MANAGER_SMS_ACCESS_KEY_ID=
MANAGER_SMS_ACCESS_KEY_SECRET=
MANAGER_SMS_SIGN_NAME=
MANAGER_SMS_TEMPLATE_CODE=
MANAGER_SMS_SEND_INTERVAL=60
MANAGER_SMS_VALID_TIME=300

WECHAT_PAY_ENABLED=0
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_MCH_CERT_SERIAL=
WECHAT_PAY_MCH_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://example.com/api/wallet/notify/wechat
WECHAT_PAY_PLATFORM_CERT_PATH=

ALIPAY_ENABLED=0
ALIPAY_APP_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_APP_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_NOTIFY_URL=https://example.com/api/wallet/notify/alipay
ALIPAY_RETURN_URL=
# page=电脑网站支付（默认）；precreate=当面付预下单出 QR
ALIPAY_TRADE_MODE=page

# 无支付渠道时允许开发入账
RECHARGE_DEV_AUTO=1
